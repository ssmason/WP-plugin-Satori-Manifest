{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "satori-manifest/registration-form",
	"version": "1",
	"title": "Registration form",
	"category": "widgets",
	"icon": "id-alt",
	"description": "Public sign-up form for new clients. Submissions arrive under Manifest → Applications for approval.",
	"keywords": [
		"register",
		"signup",
		"apply",
		"form"
	],
	"textdomain": "satori-manifest",
	"render": "file:./render.php",
	"style": "file:../../build/css/registration.css",
	"supports": {
		"html": false,
		"multiple": false,
		"align": [
			"wide"
		]
	}
}
