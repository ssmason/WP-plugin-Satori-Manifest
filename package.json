{
	"name": "satori-manifest",
	"version": "3.0.0",
	"description": "Hosted, branded price-list pages for QR-code clients.",
	"author": "Stephen Mason <steve@satori-digital.com>",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"build": "webpack --mode production",
		"dev": "webpack --mode development --watch",
		"lint:js": "eslint \"src/blocks/**/*.js\" \"src/js/**/*.js\" webpack.config.js",
		"lint:scss": "stylelint \"src/scss/**/*.scss\" \"designs/**/*.scss\"",
		"lint:php": "./vendor/bin/phpcs --standard=.phpcs.xml .",
		"pot": "wp i18n make-pot . languages/satori-manifest.pot",
		"test:php": "docker exec -w /var/www/html/web/app/plugins/satori-manifest qr-code-manager-php-1 vendor/bin/phpunit",
		"cypress:open": "cypress open",
		"cypress:run": "cypress run",
		"lint": "npm run lint:php && npm run lint:js && npm run lint:scss",
		"test": "npm run test:php",
		"check:classes": "docker exec qr-code-manager-php-1 vendor/bin/wp eval-file web/app/plugins/satori-manifest/tests/tools/check-class-references.php --allow-root"
	},
	"devDependencies": {
		"@babel/core": "^7.24.0",
		"@babel/preset-env": "^7.24.0",
		"@babel/preset-react": "^7.24.0",
		"@wordpress/eslint-plugin": "^21.0.0",
		"@wordpress/scripts": "^30.0.0",
		"@wordpress/stylelint-config": "^23.0.0",
		"babel-loader": "^9.1.3",
		"css-loader": "^7.1.2",
		"cypress": "^13.17.0",
		"mini-css-extract-plugin": "^2.9.2",
		"sass": "^1.83.0",
		"sass-loader": "^16.0.4",
		"stylelint": "^16.12.0",
		"webpack": "^5.97.1",
		"webpack-cli": "^5.1.4"
	}
}
