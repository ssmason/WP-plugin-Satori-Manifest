{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "satori-manifest/contact-form",
	"version": "1",
	"title": "Contact form",
	"category": "widgets",
	"icon": "email",
	"description": "Name, email and message. Messages are emailed to the staff address in Manifest → Settings.",
	"keywords": [
		"contact",
		"email",
		"message",
		"form"
	],
	"textdomain": "satori-manifest",
	"render": "file:./render.php",
	"editorScript": "file:../../build/blocks/contact-form.js",
	"style": "file:../../build/css/registration.css",
	"supports": {
		"html": false,
		"multiple": false,
		"align": [
			"wide"
		]
	}
}
